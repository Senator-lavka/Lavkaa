*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f7f0df;color:#2b1c12}button,input,textarea{font:inherit}.app{max-width:1080px;margin:0 auto;padding:18px 14px 120px}.hero{display:flex;justify-content:space-between;gap:18px;align-items:center;background:linear-gradient(135deg,#3d2818,#75502e);color:#fff;border-radius:28px;padding:26px;box-shadow:0 16px 40px #7c5a3540}.eyebrow{display:inline-flex;align-items:center;gap:7px;background:#ffffff20;border:1px solid #ffffff30;padding:7px 11px;border-radius:999px;font-size:13px}.hero h1{font-family:Georgia,serif;font-size:42px;line-height:1;margin:16px 0 8px}.hero p{margin:0;color:#f8e8ca;max-width:520px}.notice{background:#fff8d9;border:1px solid #ead37b;border-radius:18px;padding:14px 16px;margin:16px 0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}.product-card{background:#fffaf0;border:1px solid #eadbc2;border-radius:24px;overflow:hidden;box-shadow:0 10px 30px #63451b18}.photo-wrap{height:260px;position:relative;background:#e9dcc7}.photo-wrap img{width:100%;height:100%;object-fit:cover;display:block}.badge{position:absolute;left:12px;top:12px;padding:7px 12px;border-radius:999px;font-weight:800;font-size:13px;backdrop-filter:blur(8px)}.badge.ok{background:#e2ffd8;color:#236015}.badge.no{background:#ffe0dc;color:#8e2118}.dots{position:absolute;bottom:12px;left:0;right:0;display:flex;gap:7px;justify-content:center}.dots button{width:9px;height:9px;border:0;border-radius:99px;background:#ffffff95}.dots button.active{background:#fff;width:24px}.product-body{padding:16px}.product-body h3{margin:0 0 8px;font-size:20px}.product-body p{margin:0 0 14px;color:#6b5948;font-size:14px}.row{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px}.row b{font-size:21px}.row span{font-size:13px;color:#7c6b57}.buy-row{display:flex;align-items:center;gap:10px}.add,.order,.panel button,.login button{border:0;border-radius:16px;background:#4b7d32;color:#fff;font-weight:900;padding:13px 16px;cursor:pointer}.add{flex:1}.add:disabled{opacity:.45;cursor:not-allowed}.round{width:43px;height:43px;border:0;border-radius:15px;background:#efe1c9}.qty{font-weight:900;min-width:18px;text-align:center}.cart{position:fixed;left:50%;bottom:14px;transform:translateX(-50%);width:min(720px,calc(100% - 24px));background:#fffaf0;border:1px solid #e4d1b3;border-radius:24px;padding:16px;box-shadow:0 16px 55px #2e1b0f35}.cart h2{margin:0 0 7px;font-size:18px}.cart p{margin:0;color:#7c6b57}.cart-line,.total{display:flex;justify-content:space-between;gap:12px;padding:6px 0}.cart-line small{color:#7c6b57}.total{border-top:1px solid #eadbc2;margin-top:6px;padding-top:12px;font-size:20px}.order{width:100%;margin-top:10px;background:#6a3f20}.empty{text-align:center;padding:40px;color:#7c6b57}.admin{min-height:100vh;background:#f7f0df;padding:18px;max-width:920px;margin:0 auto}.login,.panel{background:#fffaf0;border:1px solid #e3d4ba;border-radius:24px;padding:18px;box-shadow:0 10px 30px #63451b18}.login{max-width:420px;margin:80px auto;text-align:center}.login svg{color:#6a3f20}.login input,.panel input,.panel textarea{width:100%;border:1px solid #d5c2a5;background:#fffdf8;border-radius:15px;padding:13px;margin:8px 0}.panel textarea{min-height:88px;resize:vertical}.admin-head{display:flex;align-items:center;justify-content:space-between}.admin-head h1{font-family:Georgia,serif}.admin-head a{color:#4b7d32;font-weight:900}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.file{display:flex;align-items:center;justify-content:center;gap:8px;border:2px dashed #c8ad85;border-radius:18px;padding:18px;margin:10px 0;cursor:pointer}.file input{display:none}.admin-item{display:grid;grid-template-columns:1fr 90px 48px;gap:10px;align-items:center;border-top:1px solid #eadbc2;padding:12px 0}.admin-item>div{display:flex;gap:10px;align-items:center}.admin-item img{width:46px;height:46px;border-radius:12px;object-fit:cover}.admin-item small{display:block;color:#7c6b57}.admin-item input{margin:0}.danger{background:#b93a2f!important;padding:12px!important}@media(max-width:820px){.grid{grid-template-columns:1fr 1fr}.hero h1{font-size:34px}.photo-wrap{height:230px}}@media(max-width:560px){.app{padding:10px 10px 135px}.hero{border-radius:22px;padding:20px}.hero h1{font-size:32px}.grid{grid-template-columns:1fr}.photo-wrap{height:280px}.cart{bottom:8px}.two{grid-template-columns:1fr}.admin-item{grid-template-columns:1fr}.admin-head{align-items:flex-start;gap:10px;flex-direction:column}}
